{
  "name": "change-stack-local",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run styles && bun src/cli.ts",
    "demo": "bun run styles && bun src/cli.ts --demo",
    "test": "bun run styles && bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run styles && bun build --compile src/cli.ts --outfile dist/cstack",
    "notices": "bun scripts/notices.ts",
    "test:ui": "bun scripts/smoke-ui.ts",
    "test:line-actions": "bun run styles && bun scripts/smoke-line-actions.ts",
    "preview:conversations": "bun run styles && bun scripts/preview-conversations.ts",
    "test:conversations": "bun run styles && bun scripts/smoke-conversations.ts",
    "styles": "tailwindcss -i src/web/styles.css -o src/web/generated.css --minify",
    "test:tls": "bun scripts/smoke-tls.ts",
    "build:release": "bun run styles && bun scripts/build-release.ts"
  },
  "dependencies": {
    "@clack/prompts": "latest",
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "diff": "9.0.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
